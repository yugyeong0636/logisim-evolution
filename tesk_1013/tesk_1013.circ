  <vhdl appearance="logisim_evolution" name="and_or_out">--------------------------------------------------------------------------------&#13;
-- Description :&#13; 
-- 1, Write VHDL code.
-- 1)out1 &lt;= a and b and c and d;
-- 2)out2 &lt;= a or b or c or d;
--&#13;
--------------------------------------------------------------------------------&#13;
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;


--entity
ENTITY and_or_out IS&#13;
  PORT (&#13;
        a, b, c, d : in std_logic;
        out1, out2 : out std_logic
    );&#13;
END and_or_out;&#13;  -- ENTITY are not absolutely necessary! END; 가능

&#13;--architecture
architecture bhv of and_or_out is
begin
    &#13;out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="multiplexer_8_1">--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13; 8-to-1 Multiplexer
--------------------------------------------------------------------------------&#13;
-- ch.. 8개니까 2^3... 000 001 010 011 ...
-- 
-- 
-- 
-- 
--------------------------------------------------------------------------------
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
ENTITY multiplexer_8_1 IS&#13;
  PORT (&#13;
        a, b, c, d, e, f, g, h : in std_logic;
        ch : in std_logic_vector(2 downto 0);
        data : out std_logic
    );&#13;
END multiplexer_8_1;&#13;

--arcitecture
ARCHITECTURE bhv OF multiplexer_8_1 IS&#13;
BEGIN&#13;
&#13;    process(a, b, c, d, e, f, g, h, ch)
    begin
        case ch is
            when "000" =&gt; data &lt;= a;
            when "001" =&gt; data &lt;= b;
            when "010" =&gt; data &lt;= c;
            when "011" =&gt; data &lt;= d;
            when "100" =&gt; data &lt;= e;
            when "101" =&gt; data &lt;= f;
            when "110" =&gt; data &lt;= g;
            when others =&gt; data &lt;= '0';
        end case;
    end process;&#13;
END bhv;&#13;

</vhdl>
  <vhdl appearance="logisim_evolution" name="digital_letters">--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13; Use digital tubes to display letters: a,b,c,d,f,g
--------------------------------------------------------------------------------&#13;


library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
entity digital_letters is
    port (
        en : in std_logic;
        dat : in std_logic_vector(2 downto 0);
        display : out std_logic_vector(7 downto 0)
    );
end digital_letters;


--architecture
architecture bhv of digital_letters is
begin
    process(en, dat)
    begin
        if en = '0' then
            display &lt;= "ZZZZZZZZ";
        else
            case dat is
                when "000" =&gt; display &lt;= "11101110";  -- A
                when "001" =&gt; display &lt;= "00111110";  -- b
                when "010" =&gt; display &lt;= "10011100";  -- C
                when "011" =&gt; display &lt;= "01111010";  -- d
                when "100" =&gt; display &lt;= "10001110";  -- F
                when "101" =&gt; display &lt;= "11110110";  -- g
                when others =&gt; display &lt;= "00000000";
            end case;
        end if;
    end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="voting_with_25">--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;

LIBRARY ieee;
USE ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;


entity voting_with_25 is
    port (
        vt : in std_logic_vector(25 downto 1);
        result : out std_logic
    );
end entity voting_with_25;

--architecture
architecture bhv of voting_with_25 is
begin
    process(vt)
        variable sum : integer range 0 to 25;
    begin
        sum := 0;
        for i in 1 to 25 loop
            if (vt(i) = '1') then
                sum := sum + 1;
                if sum &gt;= 13 then
                    result &lt;= '1';
                else
                    result &lt;= '0';
                end if;
            end if;
        end loop;
    end process;
end architecture bhv;

&#13;</vhdl>
  <vhdl appearance="logisim_evolution" name="vote_display">library ieee;
use ieee.std_logic_1164.all;

--entity
entity vote_display is
    port (
        en      : in  std_logic;
        vt      : in  std_logic_vector(15 downto 1);
        display : out std_logic_vector(7 downto 0)
    );
end entity vote_display;

--architecture
architecture bhv of vote_display is
begin
    process(en, vt)
        variable sum : integer range 0 to 15;
    begin
        -- 1의 개수 세기
        sum := 0;
        for i in 1 to 15 loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        if en = '1' then
            -- en = '1' : 결과 표시
            case sum is
                when 0  =&gt; display &lt;= "11111101";  -- 0
                when 1  =&gt; display &lt;= "01100001";  -- 1
                when 2  =&gt; display &lt;= "11011011";  -- 2
                when 3  =&gt; display &lt;= "11110011";  -- 3
                when 4  =&gt; display &lt;= "01100111";  -- 4
                when 5  =&gt; display &lt;= "10110111";  -- 5
                when 6  =&gt; display &lt;= "10111111";  -- 6
                when 7  =&gt; display &lt;= "11100001";  -- 7
                when 8  =&gt; display &lt;= "11111111";  -- 8
                when 9  =&gt; display &lt;= "11110111";  -- 9
                when 10 =&gt; display &lt;= "11101111";  -- A
                when 11 =&gt; display &lt;= "00111111";  -- b (B)
                when 12 =&gt; display &lt;= "10011101";  -- C
                when 13 =&gt; display &lt;= "01111011";  -- d (D)
                when 14 =&gt; display &lt;= "10011111";  -- E
                when 15 =&gt; display &lt;= "10001111";  -- F
                when others =&gt; display &lt;= "00000000";
            end case;
        else
            -- en = '0' (또는 그 외) : 꺼짐
            display &lt;= "00000000";
        end if;
    end process;
end architecture bhv;</vhdl>
</project>
