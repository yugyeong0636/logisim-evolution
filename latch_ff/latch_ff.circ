  <vhdl appearance="logisim_evolution" name="rs_latch">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY rs_latch IS
  PORT (
    s  : IN  std_logic;   -- Set
    r  : IN  std_logic;   -- Reset
    q  : OUT std_logic;
    qb : OUT std_logic
  );
END rs_latch;

ARCHITECTURE bhv OF rs_latch IS
  SIGNAL q_int, qb_int : std_logic;
BEGIN
  -- Cross-coupled NOR gates (same as the Logisim circuit)
  q_int  &lt;= r NOR qb_int;
  qb_int &lt;= s NOR q_int;

  q  &lt;= q_int;
  qb &lt;= qb_int;
END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_latch">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY d_latch IS
PORT (
    clk : IN std_logic;
    d   : IN std_logic;
    q   : OUT std_logic
);
END d_latch;

ARCHITECTURE bhv OF d_latch IS
BEGIN

    PROCESS(clk, d)
    BEGIN
        IF (clk = '1') THEN
            q &lt;= d;
        END IF;
    END PROCESS;

END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_flipflop">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY d_flipflop IS
  PORT (
    clk : IN std_logic;
    d   : IN std_logic;
    q   : OUT std_logic
  );
END d_flipflop;


ARCHITECTURE bhv OF d_flipflop IS
BEGIN
  process(clk)
  BEGIN
    IF (clk'event AND clk = '1') THEN
      q &lt;= d;
    END IF;
  END process;
END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="jk_flipflop">LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY jk_flipflop IS
  PORT (
    clk : IN  std_logic;  -- Clock signal
    j   : IN  std_logic;  -- Data input
    k   : IN  std_logic;  -- Data input
    q   : OUT std_logic   -- Data output
  );
END ENTITY jk_flipflop;

ARCHITECTURE bhv OF jk_flipflop IS
  SIGNAL q_internal : std_logic := '0';  -- Internal signal to represent output q
BEGIN
  -- Drive the output port q with the internal signal
  q &lt;= q_internal;
  process(clk)
  begin
    -- Clock edge-triggered behavior
    if (clk'event and clk = '1') then
      if (j = '1' and k = '0') then
        q_internal &lt;= '1';  -- Set output to 1
      elsif (j = '0' and k = '1') then
        q_internal &lt;= '0';  -- Reset output to 0
      elsif (j = '1' and k = '1') then
        q_internal &lt;= not q_internal;  -- Toggle the output
      end if; -- Close if block
    end if; -- Close main if block
  end process;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="jkff">LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY jkff IS
  PORT (
    clk : IN  std_logic;  -- Clock signal
    j   : IN  std_logic;  -- Data input
    k   : IN  std_logic;  -- Data input
    clr : IN  std_logic;  -- Asynchronous clear signal
    set : IN  std_logic;  -- Asynchronous set signal
    q   : OUT std_logic   -- Data output
  );
END ENTITY jkff;

ARCHITECTURE bhv OF jkff IS
  SIGNAL q_internal : std_logic := '0';  -- Internal signal to represent output q
BEGIN
  -- Drive the output port q with the internal signal
  q &lt;= q_internal;
  process(clk, clr, set)
  begin
    -- Asynchronous clear (highest priority)
    if clr = '1' then
      q_internal &lt;= '0';
    -- Asynchronous set (second-highest priority)
    elsif set = '1' then
      q_internal &lt;= '1';
    -- Clock edge-triggered behavior
    elsif (clk'event and clk = '1') then
      if (j = '1' and k = '0') then
        q_internal &lt;= '1';  -- Set output to 1
      elsif (j = '0' and k = '1') then
        q_internal &lt;= '0';  -- Reset output to 0
      elsif (j = '1' and k = '1') then
        q_internal &lt;= not q_internal;  -- Toggle the output
      end if; -- Close if block
    end if; -- Close main if block
  end process;
END ARCHITECTURE bhv;</vhdl>
</project>
